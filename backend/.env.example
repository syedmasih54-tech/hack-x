# BenefitBridge - Supabase PostgreSQL Database URL
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Or Supabase Transaction Pooler (Recommended for Vercel / serverless):
# Format: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your-supabase-password@db.your-project-ref.supabase.co:5432/postgres

# BenefitBridge - DigiLocker & Meri Pehchaan (National SSO) / API Setu OAuth Credentials
DIGILOCKER_CLIENT_ID=BB_DEMO_CLIENT_ID
DIGILOCKER_CLIENT_SECRET=BB_DEMO_SECRET
DIGILOCKER_REDIRECT_URI=http://localhost:8000/auth/digilocker/callback
DIGILOCKER_AUTH_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/1/authorize
DIGILOCKER_TOKEN_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/1/token
DIGILOCKER_ISSUED_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/1/files/issued
DIGILOCKER_FILE_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/1/file

# Aliases
APISITU_CLIENT_ID=BB_DEMO_CLIENT_ID
APISITU_CLIENT_SECRET=BB_DEMO_SECRET
APISITU_REDIRECT_URI=http://localhost:8000/auth/digilocker/callback
APISITU_API_KEY=DEMO_APISITU_API_KEY_SECURE
